# Charger avec Node >= 24 : les variables déjà présentes ont priorité.
CTESTI_HOST=
CTESTI_PORT=22
# Budget de négociation SSH, puis budget renouvelé pour l'unique commande (ms).
CTESTI_TIMEOUT_MS=30000
# Nombre total de tentatives (première incluse), délai entre reprises en ms.
CTESTI_SSH_ATTEMPTS=3
CTESTI_SSH_RETRY_DELAY_MS=1000
# Espacement des ouvertures vers une cible dans le banc, sans sérialiser les scénarios.
# 0 désactive l'espacement ; 1500 a été exercé sur la cible de qualification.
CTESTI_SSH_CONNECT_INTERVAL_MS=0
CTESTI_USER=
# SHA-256 hexadécimal (64 caractères), vérifié par un canal de confiance.
CTESTI_HOST_KEY_SHA256=
CTESTI_AUTH=password
CTESTI_PASSWORD=
# Pour CTESTI_AUTH=key : chemin local, éventuellement passphrase.
CTESTI_PRIVATE_KEY=
CTESTI_PASSPHRASE=
# Commande CL exécutée par ssh:check -- --ibmi.
CTESTI_IBMI_COMMAND="DSPDTAARA DTAARA(QUSRSYS/QSS1MRI)"
CTESTI_XMLSERVICE_CLI=/QOpenSys/pkgs/bin/xmlservice-cli
# Bibliothèque dédiée aux deux objets de preuve, compilés manuellement.
CTESTI_PROOF_LIBRARY=
# CCSID mono-octet candidat : doit correspondre au job et à la compilation.
CTESTI_CCSID=297
